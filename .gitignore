# Local working material: paper drafts, raw cover art, scratch assets.
figure/

# Logo exports for slides, papers and avatars. Rebuild any time with
# tools/export_logo.py — no reason to carry them in the repository.
exports/

# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/

# Node (only if a build step is ever added)
node_modules/

# Local preview server bytecode
__pycache__/
*.pyc

# Generated browser application pack (rebuild with tools/build_playground.py)
public/playground/

# Generated trajectory media; keep locally and package separately for deployment.
# Rebuild with tools/import_case_studies.py using the pinned archive sources.
public/case-studies/
public/case-previews/

# Local source downloads, preview logs, inventories and rendered paper pages.
tmp/
dist/

# Local credentials are never website source.
.env
.env.*
!.env.example
.envv
